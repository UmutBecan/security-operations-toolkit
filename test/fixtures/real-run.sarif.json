              "helpUri": "https://github.com/UmutBecan/security-operations-toolkit/blob/main/docs/checks.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "external-posture",
                  "dmarc"
                ],
                "precision": "high"
              }
            },
            {
              "id": "mta-sts/missing",
              "shortDescription": {
                "text": "MTA-STS not published (RFC 8461)"
              },
